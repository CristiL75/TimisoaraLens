# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/TimisoaraLens
DATABASE_NAME=TimisoaraLens

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:19000,exp://192.168.100.45:8081

# Qdrant Cloud Configuration (RAG Vector Database)
QDRANT_URL=https://<your-cluster-host>:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Hugging Face Configuration (Optional - for higher HF API rate limits)
# HF_TOKEN=hf_your_token_here
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_MODEL=google/flan-t5-small  # set to any Inference API available model
OLLAMA_MODEL=llama3.2

# ChromaDB Configuration (RAG system - coming soon)
CHROMA_DB_PATH=./data/chroma_db
COLLECTION_NAME=timisoara_knowledge

# Model Paths (Vision - to be added later)
# VISION_MODEL_PATH=./models/mobilenet_timisoara.pth
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data Paths
COORDINATES_JSON=./data/coordinates.json
METADATA_JSON=./data/metadata.json
IMAGES_PATH=./data/images
DOCUMENTS_PATH=./data/documents

# App Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_ORIGINS=http://localhost:19000,http://localhost:19001

# MongoDB Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=citylens_timisoara

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-12345
ACCESS_TOKEN_EXPIRE_MINUTES=10080
