             <script>
    $(function() {
        bizx.cmp.ifConsent({ purposes: 'all' , vendors: 'narrative'}, function() {
            var current_time = (new Date()).getTime();
            let imageUrl = "https://io.narrative.io/?companyId=2440&id=first_party%3A32858ea8-f05c-42e0-9b9d-3ffc7ce7c8b5&id=site_name%3Asourceforge.net&id=url%3A%2Fprojects%2Fplantuml%2Ffiles%2Fplantuml.jar%2Fdownload&id=pagetitle%3ADownload+plantuml.jar+%28plantuml%29&id=vertical%3AOpen+Source+Software&id=product%3Aplantuml&id=topics%3AUML%2CDocumentation%2CDiagram&id=programming_language%3AJava&id=action%3ADownloaded+plantuml&id=action%3ADownloaded+UML+Software";
            imageUrl = imageUrl.replace(encodeURIComponent("$PAGE_TITLE"), document.title);  

            imageUrl = URL.parse(imageUrl);
            let hem = bizx.uids.getHem();
            if (hem) {
                imageUrl.searchParams.append('id', 'hem:' + hem);
            }
            imageUrl.searchParams.append('rand', current_time);

            var image = new Image();
            image.src = imageUrl.toString();
            image.style.display = "none";
            image.style.height = 0;
            image.style.width = 0;
            document.body.appendChild(image);
        });
    });
</script>
        

        
            
